		{"id":"32037094707628da","type":"text","text":"# My Coffee\n\n| ID  | Roaster_ID | Coffee_Grams | Coffee_Purchased_Date |\n| --- | ---------- | ------------ | --------------------- |\n| 1   | 101        | 500.00       | 30/12/25 14:00        |\n| 2   | 102        | 250.00       | 18/07/25 10:00        |\n``` SQL\nCREATE TABLE my_coffee {\nID int PRIMARY KEY,\nRoaster_ID int,\nRoaster_Bag_Grams float,\nCoffee_Purchased_Data datetime,\nCONSTRAINT FK_Roaster FOREIGN KEY (Roaster_ID)\nREFERENCE Roaster(Roaster_ID)\n}:\n\n```\n","x":-420,"y":-600,"width":580,"height":460,"color":"2"},
		{"id":"da31933ebba6eb3a","type":"text","text":"# Brewing\n\n| ID  | Brewing_Date   | *==Method_ID==* | Roast_ID | Description |\n| --- | -------------- | --------------- | -------- | ----------- |\n| 1   | 31/12/25 21:00 | 302             |          |             |\n| 2   | 28/10/25 8:00  | 301             |          |             |\n```SQL\nCREATE TABLE brewing {\nMethod_ID int,\nCONSTRAINT FK_Method FOREIGN KEY (Method_ID)\nREFERENCE Methods(Method_ID)\n};\n```","x":-420,"y":-1120,"width":580,"height":391,"color":"1"},
		{"id":"d126e6cdf1ddebcd","type":"text","text":"# Roaster\n\n| *==Roaster_ID==* | Roaster_Name | Roast_Type  | Roast_Date | ==*Coffee_ID*== |\n| ---------------- | ------------ | ----------- | ---------- | --------------- |\n| 101              | Bocanegra    | Medium      |            | 202             |\n| 102              | Paso Paso    | Medium-Dark |            | 203             |\n\n``` SQL\nCREATE TABLE roaster {\nRoaster_Code int PRIMARY KEY,\nRoaster_Name varchar[40] NOT NULL,\nRoast_Type   varchar[20] NOT NULL,\nRoast_Date   datetime,\nCoffee_ID int\nCONSTRAINT FK_Coffee FOREIGN KEY (Coffee_ID)\nREFERENCE Coffee(Coffee_ID)\n};\n```\n\n","x":-423,"y":0,"width":586,"height":480},
		{"id":"36963219bba8a3a7","type":"text","text":"# Coffee\n\n| Coffee_ID | Coffee_Farm_Name | Coffee_Variety | Coffee_Process | Coffee_Zone | Coffee_Origin | Coffee_Altitude |\n| --------- | ---------------- | -------------- | -------------- | ----------- | ------------- | --------------- |\n| 202       | Don Elí          | SL28           | Honey          | Los Santos  | Costa Rica    | 1200            |\n| 203       | Aquiares         | Geisha         | Natural        | Turrialba   | Etiopia       | 1800            |\n``` SQL\nCREATE TABLE coffee_origin {\nCoffee_ID int PRIMARY KEY,\nCoffee_Farm_Name varchar[40] NOT NULL,\nCoffee_Variety varchar[20] NOT NULL,\nCoffee_Process varchar[20] NOT NULL,\nCoffee_Zone varchar[20] NOT NULL,\nCoffee_Origin varchar[20] NOT NULL,\nCoffee_Altitude float NOT NULL\n\n};\n```\n\n\n\n","x":-1640,"y":0,"width":1069,"height":480},
